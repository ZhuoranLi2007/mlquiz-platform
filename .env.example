# 复制本文件为 .env 后填写。.env 含密钥，已在 .gitignore 中排除，请勿提交。
# 配置由 backend/app/config.py 在进程启动时读取；真实环境变量优先级高于 .env。
# 不填写也能运行：所有依赖模型的功能会明确标注「待配置」，不会用 mock 冒充成功。

# ---- 聊天模型（OpenAI 兼容接口；provider/model/api_key 三项必填才算已配置）----
# DeepSeek 推荐配置（官方 OpenAI 兼容端点）：
MLQ_MODEL_PROVIDER=deepseek
MLQ_MODEL_BASE_URL=https://api.deepseek.com
MLQ_MODEL_CHAT_MODEL=deepseek-chat
MLQ_MODEL_API_KEY=
# 也可以用 deepseek-reasoner；其他 OpenAI 兼容供应商改这三行即可。
# 配置后，无答案原题会自动生成「AI参考答案」；结构检查与自动校验通过后
# 才会进入可用题库。

# ---- 嵌入模型：与聊天模型分开配置；不假定聊天 API 提供 embeddings ----
# 未配置/未构建索引时 /api/config/status 会如实显示 mode=keyword, vector_enabled=false
MLQ_EMBED_PROVIDER=
MLQ_EMBED_BASE_URL=
MLQ_EMBED_MODEL=
MLQ_EMBED_API_KEY=
# 索引使用维度，需与实际嵌入模型一致；0 表示未指定
MLQ_EMBED_DIM=0

# ---- 可选路径与项目规则 ----
# 可选的原资料根目录（只读）；不配置也能运行随仓库提供的演示数据。
# MLQ_MATERIAL_ROOT=D:\课程资料\机器学习
# 所有解析产物/数据库的根目录，默认项目内 data/
# MLQ_DATA_DIR=
# 演示环境快速登录；公开部署时请设为 false。
# MLQ_QUICK_LOGIN_ENABLED=true
# MLQ_QUICK_LOGIN_TEACHER_PASSWORD=TeacherDemo!2026
# 学习计划使用的考试日期
MLQ_EXAM_DATE=2026-12-02

# 配置后请访问 http://127.0.0.1:8000/api/model/connection-test 做真实连通性诊断。
# 首次接入建议先用少量样例验证输出结构、引用与题目质量，再扩大范围。
