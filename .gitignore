*.db
*.sqlite
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.pid

# Editors / operating system
.vscode/
.idea/
~$*
.DS_Store
Thumbs.db
desktop.ini

# Reviewed acceptance snapshots only; live databases stay ignored
!data/acceptance/
data/acceptance/*
