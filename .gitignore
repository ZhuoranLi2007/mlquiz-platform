# Secrets and local credentials
.env
*.key
*.pem
data/private/

# Python / Node environments and caches
.venv/
backend/.venv/
node_modules/
frontend/node_modules/
__pycache__/
*.py[cod]
.pytest_cache/
.pytest-*/
.mypy_cache/
*.log

# Generated frontend and test output
frontend/dist/
coverage/
htmlcov/

# Runtime data: only the sanitised demo package is versioned
data/*
!data/demo/
data/demo/*
!data/demo/README.md
!data/demo/mlquiz-course-demo.sqlite3.gz
!data/demo/assets/
!data/demo/assets/**

# Backend restoration and read-back verification scripts are versioned.

# Local audits, generated reports and source-course material
# Sanitised docs, reports and verification evidence are versioned.
materials/
/*.md
!/README.md
/=
.workbuddy/
机器学习复习资料_结构化抽题/
